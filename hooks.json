{
  "shadow-context-guard": {
    "PreToolUse": [
      {
        "matcher": "view_file|grep_search|list_dir|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/shadow-context-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
