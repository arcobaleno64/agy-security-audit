{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://antigravity.google/schemas/security-audit/threat-model.schema.json",
  "title": "Threat Model Schema",
  "type": "object",
  "required": ["schemaVersion", "threatModelId", "target", "targetProfile", "actors", "components", "trustBoundaries"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1", "1.0.0"] },
    "threatModelId": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["repositoryUri", "revision"],
      "properties": {
        "repositoryUri": { "type": "string" },
        "revision": { "type": "string" },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean" }
      }
    },
    "targetProfile": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "detectedProfiles": { "type": "array", "items": { "type": "string" } },
        "detectedLanguages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "trustLevel", "status"],
        "properties": {
          "id": { "type": "string" },
          "trustLevel": { "type": "string", "enum": ["untrusted", "semi-trusted", "privileged"] },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["FACT", "ASSUMPTION"] },
          "evidence": { "type": ["object", "array", "null"] }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "criticality"],
        "properties": {
          "name": { "type": "string" },
          "criticality": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "description": { "type": "string" },
          "evidence": { "type": ["object", "array", "null"] }
        }
      }
    },
    "trustBoundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["boundary", "status"],
        "properties": {
          "boundary": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["FACT", "ASSUMPTION"] },
          "evidence": { "type": ["object", "array", "null"] }
        }
      }
    },
    "contextStatus": { "type": "string", "enum": ["CONFIRMED", "GENERIC_SECURITY_REVIEW", "SUGGESTED", "ABSENT"] },
    "assuranceLimitation": { "type": ["string", "null"] }
  }
}
