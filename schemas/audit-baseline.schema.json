{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://antigravity.google/schemas/security-audit/audit-baseline.schema.json",
  "title": "Audit Baseline Schema",
  "type": "object",
  "required": [
    "schemaVersion", "toolVersion", "targetRevision", "scopeFingerprint",
    "scopeFingerprint", "surfaceFingerprint", "threatModelFingerprint",
    "coverageFingerprint", "executionEquivalenceKey", "findingLineageIds", "completedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1", "1.0.0"] },
    "toolVersion": { "type": "string" },
    "targetRevision": { "type": "string" },
    "modelProvider": { "type": "string" },
    "modelIdentifier": { "type": "string" },
    "scopeFingerprint": { "type": "string" },
    "surfaceFingerprint": { "type": "string" },
    "threatModelFingerprint": { "type": "string" },
    "coverageFingerprint": { "type": "string" },
    "executionEquivalenceKey": { "type": "string" },
    "executionEquivalence": { "type": "string", "enum": ["FULL", "PARTIAL"] },
    "findingLineageIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "canonicalFindingsSummary": {
      "type": "object"
    },
    "projectContextFingerprint": { "type": ["string", "null"] },
    "securityPropertiesFingerprint": { "type": ["string", "null"] },
    "provenanceTracking": {
      "type": "object",
      "properties": {
        "trackedDirty": { "type": "boolean" },
        "untrackedDirty": { "type": "boolean" },
        "ignoredArtifactsPresent": { "type": "array", "items": { "type": "string" } }
      }
    },
    "completedAt": { "type": "string" }
  }
}
