{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://antigravity.google/schemas/security-audit/verifier-ballot-set.schema.json",
  "title": "Verifier Ballot Set Schema",
  "type": "object",
  "required": ["ballots"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1", "1.0.0"] },
    "ballots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["findingId", "lens", "decision", "rationale", "evidence"],
        "properties": {
          "schemaVersion": { "type": "string", "enum": ["1", "1.0.0"] },
          "findingId": { "type": "string" },
          "lens": { "type": "string", "enum": ["REACHABILITY", "DEFENSES", "IMPACT"] },
          "decision": { "type": "string", "enum": ["SUPPORTS", "REFUTES"] },
          "rationale": { "type": "string" },
          "nonce": { "type": "string" },
          "proofKind": {
            "type": "string",
            "enum": [
              "STATIC_TRACE",
              "UNIT_TEST",
              "BENIGN_REPRODUCTION",
              "CONFIG_EVIDENCE",
              "DEPENDENCY_EVIDENCE",
              "EXTERNAL_SCANNER_EVIDENCE",
              "MANUAL_ATTESTATION"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "evidenceHash": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
