{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://antigravity.google/schemas/security-audit/execution-attestation.schema.json",
  "title": "Execution Attestation Schema",
  "type": "object",
  "required": [
    "schemaVersion", "attestationId", "target", "requiredStages",
    "executedStages", "coverageComplete", "delegationRequired", "delegationObserved", "verdict"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1", "1.0.0"] },
    "attestationId": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["repositoryUri", "revision"],
      "properties": {
        "repositoryUri": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "auditIntent": { "type": "string", "enum": ["DISCOVERY", "VALIDATION", "REGRESSION"] },
    "requiredStages": { "type": "array", "items": { "type": "string" } },
    "executedStages": { "type": "array", "items": { "type": "string" } },
    "skippedStages": { "type": "array", "items": { "type": "string" } },
    "failedStages": { "type": "array", "items": { "type": "string" } },
    "coverageComplete": { "type": "boolean" },
    "delegationRequired": { "type": "boolean" },
    "delegationObserved": { "type": "boolean" },
    "verdict": { "type": "string", "enum": ["COMPLETE", "COMPLETE_VERIFIED", "COMPLETE_DECLARED", "INCOMPLETE", "DEGRADED"] },
    "capabilities": {
      "type": "object",
      "required": ["required", "forbidden", "status"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "observed": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["CONFORMANT", "VIOLATION", "DECLARED", "UNKNOWN"] },
        "observationSource": { "type": ["string", "null"] },
        "attestationConfidence": { "type": "string", "enum": ["OBSERVED", "DECLARED", "UNKNOWN"] }
      }
    },
    "contextIsolation": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["MANDATED", "DECLARED", "OBSERVED", "UNKNOWN"] },
        "pipeline": { "type": "string" },
        "shadowContextRoot": { "type": ["string", "null"] },
        "tokenizedFilesCount": { "type": "number" },
        "totalSecretsTokenized": { "type": "number" }
      }
    }
  }
}
