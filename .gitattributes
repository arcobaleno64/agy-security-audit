# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure text formats use LF line endings
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary file declarations
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Export ignore for clean release packaging (F-04)
scratch/ export-ignore
reports/ export-ignore
codeql-db/ export-ignore
evals/recorded-runs/ export-ignore